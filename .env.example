# Browser-facing API prefix. The Vite development server proxies this to FastAPI.
VITE_API_BASE_URL=/api

# Local FastAPI address used by the Vite development proxy.
VITE_FASTAPI_TARGET=http://localhost:8000

# Docker Compose host ports (optional overrides).
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
AIRFLOW_PORT=8080
